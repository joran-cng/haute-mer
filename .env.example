# Facultatif : `docker compose up` fonctionne sans ce fichier.
# cp .env.example .env pour surcharger.

# À remplacer hors démonstration. Les deux instances doivent partager la même valeur.
JWT_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire

# Jouer en réseau local : ajouter l'adresse du poste serveur à la liste blanche.
# ALLOWED_ORIGINS=http://localhost:8088,https://localhost:8443,http://192.168.1.20:8088,https://192.168.1.20:8443

# Délais de jeu (ms)
TURN_MS=45000
PLACEMENT_MS=120000

# Fenêtre de regroupement de la présence (0 = désactivé, sert au protocole de mesure)
PRESENCE_BATCH_MS=500
